async function loadGameMenu() {
    try {
        const response = await fetch('games.json'); // Grabs your file
        const games = await response.json();        // Converts text to a JS object
        const menu = document.getElementById('mainMenu');

        games.forEach(game => {
            // Create a "card" for each game
            const gameCard = document.createElement('div');
            gameCard.className = 'game-card';
            
            gameCard.innerHTML = `
                <img src="${game.thumbnail}" alt="${game.name}" width="100">
                <h3>${game.name}</h3>
                <button onclick="loadGame('${game.url}')">Play Now</button>
            `;
            
            menu.appendChild(gameCard);
        });
    } catch (error) {
        console.error("Error loading games.json:", error);
    }
}

