let allGames = []; // Global variable to hold your games

async function loadGameMenu() {
    try {
        const response = await fetch('games.json');
        allGames = await response.json(); 
        displayGames(allGames); // Initial load
    } catch (error) {
        console.error("Error loading games:", error);
    }
}

// Function to render the list of games
function displayGames(games) {
    const menu = document.getElementById('mainMenu');
    menu.innerHTML = ''; // Clear current list

    games.forEach(game => {
        const gameCard = document.createElement('div');
        gameCard.className = 'game-card';
        gameCard.innerHTML = `
            <img src="${game.thumbnail}" alt="${game.name}">
            <h3>${game.name}</h3>
            <button onclick="loadGame('${game.url}')">Play Now</button>
        `;
        menu.appendChild(gameCard);
    });
}

// Function to filter based on search input
function filterGames() {
    const searchTerm = document.getElementById('gameSearch').value.toLowerCase();
    
    // Filter the array using .includes() for partial matches
    const filtered = allGames.filter(game => 
        game.name.toLowerCase().includes(searchTerm)
    );
    
    displayGames(filtered);
}
