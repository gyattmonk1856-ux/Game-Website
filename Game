<!-- Main Menu -->
<div id="mainMenu">
    <h1>My Unblocked Games</h1>
    <!-- Buttons to trigger the loadGame function -->
    <button onclick="loadGame('https://example.com')">Play Game 1</button>
    <button onclick="loadGame('https://example.com')">Play Game 2</button>
</div>

<!-- Hidden Game Container -->
<div id="gameContainer" style="display: none;">
    <button onclick="goBack()">Back to Menu</button>
    <iframe id="gameFrame" src="" width="800" height="600" frameborder="0"></iframe>
</div>
async function loadGameList() {
    try {
        const response = await fetch('games.json');
        const games = await response.json();
        const menu = document.getElementById('mainMenu');

        games.forEach(game => {
            const btn = document.createElement('button');
            btn.innerText = game.name;
            btn.onclick = () => loadGame(game.url);
            menu.appendChild(btn);
        });
    } catch (error) {
        console.error("Could not load game list:", error);
    }
}

// Run this when the page loads
window.onload = loadGameList;
