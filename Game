// Initialize favorites from localStorage or an empty array
let favorites = JSON.parse(localStorage.getItem('gameFavorites')) || [];

function toggleFavorite(gameId) {
    const index = favorites.indexOf(gameId);
    
    if (index === -1) {
        favorites.push(gameId); // Add to favorites
    } else {
        favorites.splice(index, 1); // Remove from favorites
    }

    localStorage.setItem('gameFavorites', JSON.stringify(favorites));
    displayGames(allGames); // Refresh the UI to show the change
}

// Updated display function to include the Favorite button
function displayGames(games) {
    const menu = document.getElementById('mainMenu');
    menu.innerHTML = '';

    games.forEach(game => {
        const isFavorited = favorites.includes(game.id);
        const gameCard = document.createElement('div');
        gameCard.className = 'game-card';
        
        gameCard.innerHTML = `
            <div class="fav-icon" onclick="toggleFavorite(${game.id})">
                ${isFavorited ? '★' : '☆'}
            </div>
            <img src="${game.thumbnail}" alt="${game.name}">
            <h3>${game.name}</h3>
            <button onclick="loadGame('${game.url}')">Play Now</button>
        `;
        menu.appendChild(gameCard);
    });
}
