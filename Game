function playRandomGame() {
    if (allGames.length === 0) {
        alert("Wait for the games to load first!");
        return;
    }

    // Pick a random index between 0 and the length of the list
    const randomIndex = Math.floor(Math.random() * allGames.length);
    const randomGame = allGames[randomIndex];

    // Optional: Alert the user what was picked before loading
    console.log("Randomly selected:", randomGame.name);
    
    // Use your existing loadGame function to open it
    loadGame(randomGame.url);
}
